# Brevo embedded-form action URL (from Brevo > Forms > Embed > HTML). Leave empty to use Netlify Forms.
BREVO_FORM_ACTION=

# Netlify build hook URL for the scheduled launch rebuilds (netlify/functions/launch-rebuild.mjs). Never commit it.
LAUNCH_BUILD_HOOK_URL=
# 1 = build in launch mode now (preview). Leave empty in production; the build flips itself after the first unlock.
LAUNCHED=
# 1 = include draft: true pages (guide skeletons, sample guide, checklist and map tools) in a local build.
DRAFTS=
