<!doctype html>
<html lang="{{ site.lang }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.className="js"</script>
{%- set pageTitle = metaTitle or title or site.name %}
{%- set pageDesc = description or site.description %}
{%- set canonical = page.url | absUrl(site.url) %}
{%- set ogImage = (og_image or site.defaultOgImage) | absUrl(site.url) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<meta name="theme-color" content="#0D0812">
<meta property="og:type" content="{{ 'article' if article else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="{{ site.locale }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/oswald-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin>
<style>{% inlineCss %}</style>
{%- include "partials/consent-analytics.njk" %}
{%- include "partials/jsonld.njk" %}
</head>
<body class="{{ 'is-home' if page.url == '/' else 'is-inner' }}">
<a class="skip" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main" class="main"{% if claim %} data-page-type="claim"{% endif %}>
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script type="application/json" id="wp-unlock">{{ { status: site.unlock.status, regions: site.unlock.regions } | json | safe }}</script>
<script src="/assets/js/site.js" defer></script>
<script src="/assets/js/enhance.js" defer></script>
{%- if "data-yt=" in content or "data-aff=" in content or "data-copy-from" in content or "data-region-row" in content or "data-checklist" in content or "data-embed-promo" in content or "data-wave-id" in content and "class=\"wave\"" in content %}
<script src="/assets/js/extras.js" defer></script>
{%- endif %}
</body>
</html>
