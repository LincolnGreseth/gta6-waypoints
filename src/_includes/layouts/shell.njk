---
layout: layouts/base.njk
---
{%- from "partials/launch-swap.njk" import swap with context %}
{#- Pre-launch shell: real copy only, no placeholder data. Filled with verified data after Nov 19. -#}
<article class="wrap page page--shell">
  {% include "partials/breadcrumbs.njk" %}
  <header class="page__head">
    <div class="page__kick">{% set pageKicker = "Guide hub" %}
      <p class="kicker kicker--page">{{ kicker or pageKicker }}</p>
      {%- if site.launchCopy.pre.shellPill %}<p class="shell__pill">{{ swap("shellPill") }}</p>{% endif %}
    </div>
    <h1>{{ h1 or title }}</h1>
    {%- if lead and leadLive %}
    <p class="lead" data-launch="pre"{% if launch.launched %} hidden{% endif %}>{{ lead | safe }}</p>
    <p class="lead" data-launch="live"{% if not launch.launched %} hidden{% endif %}>{{ leadLive | safe }}</p>
    {%- elif lead %}
    <p class="lead">{{ lead | safe }}</p>
    {%- endif %}
    {% include "partials/page-meta.njk" %}
  </header>
  {%- set cdSize = "compact" %}
  {% include "partials/countdown.njk" %}
  <div class="prose">
    {{ content | safe }}
  </div>
  {%- if related and related.length %}
  <nav class="related" aria-labelledby="related-h">
    <h2 id="related-h">Related</h2>
    <ul>
      {%- for r in related %}
      <li><a href="{{ r.url }}">{{ r.text }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
  {%- endif %}
  {% include "partials/sources.njk" %}
  {%- set signup = {} %}
  {% include "partials/email-signup.njk" %}
</article>
