{#- Live countdown to the viewer's store-region unlock. Config: site.json → countdown + unlock.
    Size: set cdSize = "compact" before including (default "hero"). Every region select on the page
    shares one state through site.js (window.WP). -#}
{%- set cd = site.countdown %}
{%- set size = cdSize or "hero" %}
{%- set ul = site.unlock | unlockList %}
{%- if cd.enabled %}
<section class="cd cd--{{ size }}" data-countdown data-target="{{ cd.target }}" data-heading="{{ cd.heading }}" data-live-heading="{{ cd.liveHeading }}" aria-labelledby="cd-h-{{ size }}">
  {%- if size == "hero" %}
  <div class="cd__fins" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  {%- endif %}
  <div class="cd__body">
    <p class="cd__heading" id="cd-h-{{ size }}" data-cd-heading>{{ cd.heading }}</p>
    <div class="cd__clock" role="timer" aria-live="off" aria-hidden="true" data-cd-clock>
      <span class="cd__unit"><b data-cd="d">--</b><small>days</small></span>
      <span class="cd__unit"><b data-cd="h">--</b><small>hrs</small></span>
      <span class="cd__unit"><b data-cd="m">--</b><small>min</small></span>
      <span class="cd__unit"><b data-cd="s">--</b><small>sec</small></span>
    </div>
    <p class="vh" aria-live="polite" data-cd-summary></p>
    <div class="cd__live" data-cd-live hidden>
      <p>{{ cd.liveText }}</p>
      <a class="btn" href="{{ cd.liveLink.url }}">{{ cd.liveLink.text }}</a>
    </div>
    <p class="cd__unlock">{% badge site.unlock.status %} <span data-cd-unlock>Unlocks at midnight in your time zone</span></p>
    <p class="cd__date">{{ cd.dateText }} on {{ cd.platforms }} {% badge cd.status %} <a href="{{ cd.sourceUrl }}" rel="noopener">Source</a></p>
    <div class="cd__region">
      <label for="region-{{ size }}">Your store region</label>
      <select id="region-{{ size }}" data-region-select>
        <option value="local">Midnight in your time zone</option>
        {%- for r in ul.regions %}
        <option value="{{ r.id }}">{{ r.name }}</option>
        {%- endfor %}
      </select>
      <p class="cd__hint">Your unlock follows your PlayStation or Xbox account region, not your device.{% if size == "hero" %} {{ site.unlock.note }}{% endif %}</p>
    </div>
  </div>
</section>
{%- endif %}
