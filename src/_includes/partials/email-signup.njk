{#- Email signup: the unlock alert. Posts to Brevo when BREVO_FORM_ACTION is set (REGION + INTEREST
    contact attributes), otherwise Netlify Forms (region + interest fields). One signup per page.
    Set `signup` before including to override: { heading, text, button, interest, region: "select"|"hidden"|"none", inline }.
    The region is pre-filled from the region picker (site.js → enhance.js). -#}
{%- set s = signup or {} %}
{%- set interest = s.interest or "unlock-alert" %}
{%- set regionMode = s.region or "select" %}
{%- set brevo = env.brevoAction %}
{%- set ul = site.unlock | unlockList %}
{%- if s.cta %}
<div class="signup signup--cta" id="signup">
{%- else %}
<section class="signup" id="signup" aria-labelledby="signup-h">
  <h2 id="signup-h">{{ s.heading or "Get pinged the moment it unlocks" }}</h2>
  <p>{{ s.text or "One email when GTA 6 unlocks in your region, then the day-one guide drop. No spam, unsubscribe any time." }}</p>
{%- endif %}
  {%- if brevo %}
  <form class="signup__form" method="post" action="{{ brevo }}" data-signup data-interest="{{ interest }}">
    <input type="hidden" name="locale" value="en">
    <input type="hidden" name="INTEREST" value="{{ interest }}">
    <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off"></label></div>
  {%- else %}
  <form class="signup__form" name="signup" method="post" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" data-signup data-interest="{{ interest }}">
    <input type="hidden" name="form-name" value="signup">
    <input type="hidden" name="interest" value="{{ interest }}">
    <div class="hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></div>
  {%- endif %}
    {%- set regionName = "REGION" if brevo else "region" %}
    {%- if regionMode == "select" %}
    <label class="vh" for="signup-region">Your store region</label>
    <select id="signup-region" name="{{ regionName }}" data-signup-region>
      <option value="local">My time zone (not sure of my store region)</option>
      {%- for r in ul.regions %}
      <option value="{{ r.id }}">{{ r.name }} store</option>
      {%- endfor %}
    </select>
    {%- elif regionMode == "hidden" %}
    <input type="hidden" name="{{ regionName }}" value="local" data-signup-region>
    {%- else %}
    <input type="hidden" name="{{ regionName }}" value="">
    {%- endif %}
    <label class="vh" for="signup-email">Email address</label>
    <input id="signup-email" type="email" name="{{ 'EMAIL' if brevo else 'email' }}" autocomplete="email" placeholder="you@example.com" required>
    <button type="submit" class="btn">{{ s.button or "Alert me" }}</button>
  </form>
  <p class="signup__fine">{% if regionMode != "none" %}We store your store region with your email so the alert lands at your unlock time. {% endif %}<a href="/privacy/">Privacy</a></p>
{%- if s.cta %}
</div>
{%- else %}
</section>
{%- endif %}
