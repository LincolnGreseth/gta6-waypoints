{%- if page.url == "/" %}{% set footerUpdated = collections.all | latestUpdated %}{% endif %}
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__row">
      <p class="disclaimer" data-disclaimer>{{ site.disclaimer }}</p>
      <ul class="site-footer__links">
        {%- for item in site.footerLinks %}
        <li><a href="{{ item.url }}">{{ item.text }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="site-footer__row site-footer__row--meta">
      <p class="site-footer__meta"><a href="/disclaimer/#affiliate-disclosure">Affiliate disclosure</a>{% if footerUpdated or updated %}<span>Updated <time datetime="{{ (footerUpdated or updated) | isoDate }}" data-updated>{{ (footerUpdated or updated) | readableDate }}</time></span>{% endif %}<span>No leaks, ever.</span></p>
      {% set socialStyle = "icons" %}{% include "partials/social.njk" %}
    </div>
  </div>
</footer>
