<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__row">
      <p class="disclaimer" data-disclaimer>{{ site.disclaimer }}</p>
      <ul class="site-footer__links">
        {%- for item in site.footerLinks %}
        <li><a href="{{ item.url }}">{{ item.text }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <p class="site-footer__meta"><a href="/disclaimer/#affiliate-disclosure">Affiliate disclosure</a>{% if updated %}<span>Updated <time datetime="{{ updated | isoDate }}" data-updated>{{ updated | readableDate }}</time></span>{% endif %}<span>No leaks, ever.</span></p>
    {% include "partials/social.njk" %}
  </div>
</footer>
