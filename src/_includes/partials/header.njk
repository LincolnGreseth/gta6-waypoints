<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="{{ site.name }} home">
      <svg class="wordmark__pin" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="#FF3D8B" d="M12 1.5c-4.4 0-8 3.5-8 7.9 0 5.8 7.1 12.4 7.4 12.7.3.3.9.3 1.2 0 .3-.3 7.4-6.9 7.4-12.7 0-4.4-3.6-7.9-8-7.9Z"/><circle cx="12" cy="9.4" r="3.1" fill="#22E0D0"/></svg>
      <span>GTA 6 Waypoints</span>
    </a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
        {%- endfor %}
      </ul>
      {% include "partials/social.njk" %}
    </nav>
  </div>
</header>
