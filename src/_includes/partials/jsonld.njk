{%- set trail = page.url | crumbs(collections.all, crumb or title) %}
<script type="application/ld+json">{{ {
  siteUrl: site.url,
  siteName: site.name,
  social: site.social,
  home: page.url == "/",
  url: page.url,
  title: title,
  description: description or site.description,
  image: og_image or (page.url | ogFor(site.ogBySection)) or site.defaultOgImage,
  crumbs: trail,
  article: article,
  updated: updated,
  published: date if article == "news" else published,
  faq: faq,
  steps: steps,
  h1: h1
} | jsonld | safe }}</script>
