{#- Social links, rendered only for networks with a URL in site.json → social. Our own simple stroke icons,
    not the networks' logo files. socialStyle = "icons" (default, footer) or "pills" (home "Follow along"). -#}
{%- set icons = {
  youtube: '<rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>',
  facebook: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 8H14a2 2 0 0 0-2 2v11M9.5 13.5h5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  x: '<path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>',
  tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.6 2.4 4.4 5 4.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>',
  discord: '<path d="M5 7c4-2.5 10-2.5 14 0l1.5 9c-2 1.6-4 2.4-5.5 2.6L14 17m-4 0l-1 1.6C7.5 18.4 5.5 17.6 3.5 16z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="9.5" cy="12" r="1.3" fill="currentColor"/><circle cx="14.5" cy="12" r="1.3" fill="currentColor"/>'
} %}
{%- set labels = { youtube: "YouTube", facebook: "Facebook", x: "X", tiktok: "TikTok", instagram: "Instagram", discord: "Discord" } %}
{%- set pillText = { youtube: "Shorts on YouTube", facebook: "Facebook" } %}
{%- if site.social | anyValue %}
{%- if socialStyle == "pills" %}
<ul class="follow" aria-label="Follow GTA 6 Waypoints">
  {%- for k, v in site.social %}{% if v and pillText[k] %}
  <li><a class="pillbtn" href="{{ v }}" rel="noopener me" target="_blank" data-social="{{ k }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">{{ icons[k] | safe }}</svg>{{ pillText[k] }}</a></li>
  {%- endif %}{% endfor %}
</ul>
{%- else %}
<ul class="social" aria-label="GTA 6 Waypoints elsewhere">
  {%- for k, v in site.social %}{% if v %}
  <li><a href="{{ v }}" rel="noopener me" target="_blank" aria-label="GTA 6 Waypoints on {{ labels[k] }}" data-social="{{ k }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">{{ icons[k] | safe }}</svg></a></li>
  {%- endif %}{% endfor %}
</ul>
{%- endif %}
{%- endif %}
