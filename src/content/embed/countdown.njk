---
title: "GTA 6 Countdown Widget | GTA 6 Waypoints"
description: "Embeddable live countdown to GTA 6's November 19, 2026 launch, by store region. For websites and blogs."
noindex: true
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en" class="no-js t-dark s-wide">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ '/release-date-times/' | absUrl(site.url) }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@700&family=Kanit:ital,wght@1,600;1,800&display=block">
<style>
*{box-sizing:border-box}html,body{margin:0}body{font:700 14px/1.4 "Atkinson Hyperlegible",system-ui,sans-serif;color:#FDF3EA;padding:12px 16px;overflow:hidden}
.t-dark body{background:#170A2E}.t-transparent body{background:transparent}.t-transparent p,.t-transparent small{text-shadow:0 1px 3px rgba(0,0,0,.85)}
p{margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;height:1.4em}
.h{font:italic 600 18px/1.4 Kanit,"Arial Narrow",sans-serif}
.c{display:flex;gap:4%;margin:6px 0 8px;height:76px}.no-js .c{visibility:hidden}
.c span{display:flex;flex-direction:column}
.c b{display:block;width:1.3em;height:1em;font:italic 800 56px/1 Kanit,"Arial Narrow",sans-serif;font-variant-numeric:tabular-nums;color:#FF3D8B;text-shadow:0 0 4px rgba(255,61,139,.9),0 0 18px rgba(255,61,139,.55),0 0 42px rgba(255,61,139,.3)}
.c small{font-size:12px;font-weight:400;color:#C9B8DA;height:16px;margin-top:4px}
.u{color:#FDF3EA}.u i{font-style:normal;font-size:12px;color:#C9B8DA;border:1px dashed #C9B8DA;border-radius:9px;padding:0 6px;margin-right:6px}
.cr{font-size:12px;font-weight:400;color:#C9B8DA;margin-top:6px}.cr a{color:#22E0D0}
.s-compact .h{font-size:14px}.s-compact .c{height:52px}.s-compact .c b{font-size:36px}.s-compact .c small{font-size:11px}
</style>
</head>
<body data-embed>
<p class="h" id="h">{{ site.countdown.heading }}</p>
<div class="c" id="c" aria-hidden="true"><span><b id="d">--</b><small>days</small></span><span><b id="hh">--</b><small>hrs</small></span><span><b id="m">--</b><small>min</small></span><span><b id="s">--</b><small>sec</small></span></div>
<p class="u"><i>{{ "Unverified" if site.unlock.status != "confirmed" else "Confirmed" }}</i><span id="u">{{ site.countdown.dateText }} · {{ site.countdown.platforms }}</span></p>
<p class="cr"><a href="{{ site.url }}/release-date-times/?ref=embed" target="_blank" rel="noopener">Countdown by GTA 6 Waypoints</a> · Fan site, not affiliated with Rockstar Games</p>
<script>{% include "partials/embed-clock-js.njk" %}</script>
</body>
</html>
