---
title: "GTA 6 Countdown OBS Overlay | GTA 6 Waypoints"
description: "Transparent GTA 6 countdown overlay for an OBS browser source at 1920×1080, by store region."
noindex: true
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en" class="no-js t-transparent s-wide">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1920">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="noindex">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/jetbrains-mono-500.woff2" as="font" type="font/woff2" crossorigin>
<style>
@font-face{font-family:Oswald;src:url(/assets/fonts/oswald-600.woff2) format("woff2");font-weight:600;font-display:block}
@font-face{font-family:Barlow;src:url(/assets/fonts/barlow-600.woff2) format("woff2");font-weight:600;font-display:block}
@font-face{font-family:"JetBrains Mono";src:url(/assets/fonts/jetbrains-mono-500.woff2) format("woff2");font-weight:500;font-display:block}
html,body{margin:0;background:transparent}body{width:1920px;height:1080px;display:flex;align-items:flex-end;padding:0 0 96px 112px;box-sizing:border-box;font:700 28px/1.4 Barlow,system-ui,sans-serif;color:#F4F1F7;overflow:hidden}
p{margin:0;text-shadow:0 2px 6px rgba(0,0,0,.9)}
.h{font:600 44px/1.3 Oswald,"Arial Narrow",sans-serif}
.c{display:flex;gap:48px;margin:8px 0 12px;height:210px}.no-js .c{visibility:hidden}
.c span{display:flex;flex-direction:column}
.c b{display:block;width:1.3em;height:1em;font:500 160px/1 "JetBrains Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums;color:#F4F1F7}
.c small{font-size:26px;font-weight:400;color:#F4F1F7;margin-top:8px;text-shadow:0 2px 6px rgba(0,0,0,.9)}
.w{font:600 26px/1 Oswald,sans-serif;color:#EE4B83;margin-top:14px;display:flex;align-items:center;gap:8px}
.h{text-transform:uppercase;letter-spacing:.5px}.c span:nth-child(4) b{color:#EE4B83}
</style>
</head>
<body data-embed>
<div>
<p class="h" id="h">{{ site.countdown.heading }}</p>
<div class="c" id="c" aria-hidden="true"><span><b id="d">--</b><small>days</small></span><span><b id="hh">--</b><small>hrs</small></span><span><b id="m">--</b><small>min</small></span><span><b id="s">--</b><small>sec</small></span></div>
<p id="u">{{ site.countdown.dateText }}</p>
<p class="w"><svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path fill="#EE4B83" d="M12 1.5c-4.4 0-8 3.5-8 7.9 0 5.8 7.1 12.4 7.4 12.7.3.3.9.3 1.2 0 .3-.3 7.4-6.9 7.4-12.7 0-4.4-3.6-7.9-8-7.9Z"/><circle cx="12" cy="9.4" r="3.1" fill="#F4F1F7"/></svg>gta6waypoints.com</p>
</div>
<script>{% include "partials/embed-clock-js.njk" %}</script>
</body>
</html>
