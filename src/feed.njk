---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.name }}: GTA 6 news</title>
  <link>{{ "/news/" | absUrl(site.url) }}</link>
  <atom:link href="{{ '/feed.xml' | absUrl(site.url) }}" rel="self" type="application/rss+xml"/>
  <description>GTA 6 news, labelled Confirmed, Reported or Rumor, sourced and dated. Fan-made; not affiliated with Rockstar Games or Take-Two Interactive.</description>
  <language>en-us</language>
  {%- set newest = collections.news | first %}
  {%- if newest %}
  <lastBuildDate>{{ (newest.data.updated or newest.date) | rssDate }}</lastBuildDate>
  {%- endif %}
  {%- for n in collections.news | limit(30) %}
  <item>
    <title>{{ n.data.title }}</title>
    <link>{{ n.url | absUrl(site.url) }}</link>
    <guid isPermaLink="true">{{ n.url | absUrl(site.url) }}</guid>
    <pubDate>{{ n.date | rssDate }}</pubDate>
    <description>{{ n.data.description }}{% if n.data.status %} [{{ n.data.status | capitalize }}]{% endif %}</description>
  </item>
  {%- endfor %}
</channel>
</rss>
